# ==============================================================================
# Daily Bots — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` (or `shared/.env`, or per-bot `<bot>/.env`) and fill
# in the values for the bots you enable. Never commit `.env` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Feishu (Lark) Custom Bot Webhooks
# ------------------------------------------------------------------------------
# Default webhook used by AI Daily News, X Hotspot, AI Builder, GitHub & HN,
# and US Stock & Crypto bots (set per-bot in `<bot>/.env` if routing to
# separate group chats).
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
# Optional Feishu webhook signature secret
# FEISHU_SECRET=

# Dedicated webhooks for A-Share & Hong Kong Stock Bot (dual-channel push)
FEISHU_WEBHOOK_CN=https://open.feishu.cn/open-apis/bot/v2/hook/your-cn-webhook-token
FEISHU_WEBHOOK_HK=https://open.feishu.cn/open-apis/bot/v2/hook/your-hk-webhook-token
# FEISHU_SECRET_CN=
# FEISHU_SECRET_HK=

# ------------------------------------------------------------------------------
# 2. AI Builder Bot (twitterapi.io — Public X List Direct Fetch)
# ------------------------------------------------------------------------------
# Get an API key from https://twitterapi.io/
TWITTERAPI_IO_KEY=
# Public X List ID (numeric ID or full https://x.com/i/lists/<id> URL)
X_LIST_ID=
# Optional tuning
# BUILDER_WINDOW_H=24
# BUILDER_PER_ACCOUNT_CAP=4
# BUILDER_LIST_SCAN_LIMIT=200
# BUILDER_INCLUDE_REPLIES=0

# ------------------------------------------------------------------------------
# 3. Notion Archiving (Optional — Idempotent Daily Upsert)
# ------------------------------------------------------------------------------
# Create an Internal Integration at https://www.notion.so/my-integrations and
# share your target database with it.
NOTION_ARCHIVE_API_KEY=
NOTION_ARCHIVE_DATABASE_ID=

# ------------------------------------------------------------------------------
# 4. Exa Targeted Enrichment (Optional — US & CN/HK Stock Bots Only)
# ------------------------------------------------------------------------------
# Used selectively for paywalled short summaries and unverified stock movers.
EXA_API_KEY=
ENABLE_EXA_ENRICH=0
# Safe fixed effort tiers: minimal | low | medium | high
EXA_AGENT_EFFORT=medium

# ------------------------------------------------------------------------------
# 5. Market Data & Proxy (Optional)
# ------------------------------------------------------------------------------
# Optional CoinGecko Demo API key & CoinMarketCap API key (free fallback works)
# COINGECKO_API_KEY=
# CMC_API_KEY=

# Optional HTTP/HTTPS proxy (only needed if direct network cannot reach APIs)
# HTTP_PROXY=http://127.0.0.1:1082
# HTTPS_PROXY=http://127.0.0.1:1082

# Optional macOS LaunchAgent plist prefix (e.g. com.example ->
# ~/Library/LaunchAgents/com.example.<bot-id>.plist). Leave unset on Linux/CI.
# BOT_PLIST_PREFIX=com.example
